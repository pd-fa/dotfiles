# macOS
.DS_Store

# Credentials — never commit
gcloud/
github-copilot/
1Password/
.jira

# Per-person identity and machine-local settings — this repo is shared, so
# anything naming an individual stays out of it. Seeded from the matching
# .example files by bootstrap.sh.
git/config.local
bootstrap.local
gh/hosts.yml

# Machine-local tool state
configstore/
containers/
herdr/
opencode/
raycast/
simple-update-notifier/
uv/
wireshark/
memos.json
.nvmrc

# Superseded / unused tooling
fish/
gatsby/
grammarly-languageserver/
gtk-2.0/
gtk-3.0/
helix/
yarn/
zed/

# Upstream clone — .zshrc bootstraps this on a fresh machine
zsh/fzf-tab/

# Editor backups and stray temp files
*.bak/
*.toml-[0-9]*

# 1Password CLI device state
op/

# tmux plugins — upstream clones, bootstrapped by tmux.conf
tmux/plugins/
