  "sidebarCSS": "/* Generated from theme/palette.toml by theme/sync-theme.py — do not edit.\n *\n * Sidebery keeps its styles in extension storage, not on disk, so this file\n * cannot be symlinked anywhere — paste it into Sidebery settings > Styles\n * editor > Sidebar, then export the settings to firefox/sidebery-settings.json\n * so the paste survives a rebuild. It is generated rather than hand-written so\n * a palette retune reaches the sidebar instead of stopping at the chrome.\n *\n * Sidebery defines every internal colour as var(--s-NAME, fallback), so these\n * twelve --s-* names are its whole supported theming surface. Anything else in\n * the sidebar is a private class that renames without warning.\n */\n\n#root.root {\n  --s-frame-bg: #0e0b17;\n  --s-frame-fg: #e9e2f8;\n  --s-toolbar-bg: #1a1530;\n  --s-toolbar-fg: #c3b3e8;\n  --s-toolbar-border: #2c2246;\n  --s-accent: #ff4fa3;\n  --s-act-el-bg: #2c2246;\n  --s-act-el-fg: #e9e2f8;\n  --s-act-el-border: #ff4fa3;\n  --s-popup-bg: #272044;\n  --s-popup-fg: #e9e2f8;\n  --s-popup-border: #2c2246;\n}",
  "groupCSS": "/* Generated from theme/palette.toml by theme/sync-theme.py — do not edit.\n *\n * Sidebery keeps its styles in extension storage, not on disk, so this file\n * cannot be symlinked anywhere — paste it into Sidebery settings > Styles\n * editor > Sidebar, then export the settings to firefox/sidebery-settings.json\n * so the paste survives a rebuild. It is generated rather than hand-written so\n * a palette retune reaches the sidebar instead of stopping at the chrome.\n *\n * Sidebery defines every internal colour as var(--s-NAME, fallback), so these\n * twelve --s-* names are its whole supported theming surface. Anything else in\n * the sidebar is a private class that renames without warning.\n */\n\n#root.root {\n  --s-frame-bg: #0e0b17;\n  --s-frame-fg: #e9e2f8;\n  --s-toolbar-bg: #1a1530;\n  --s-toolbar-fg: #c3b3e8;\n  --s-toolbar-border: #2c2246;\n  --s-accent: #ff4fa3;\n  --s-act-el-bg: #2c2246;\n  --s-act-el-fg: #e9e2f8;\n  --s-act-el-border: #ff4fa3;\n  --s-popup-bg: #272044;\n  --s-popup-fg: #e9e2f8;\n  --s-popup-border: #2c2246;\n}",
