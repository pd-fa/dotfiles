[init]
	defaultBranch = main
[gpg]
	format = ssh
[gpg "ssh"]
	program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgsign = true
[core]
	hooksPath = ~/.config/git/hooks
	excludesfile = ~/.config/git/ignore
# Per-person identity (user.name / user.email / user.signingkey) lives in an
# untracked file so this repo can be shared between people. bootstrap.sh seeds
# it from config.local.example. Included last so local values win.
# A missing include path is silently ignored by git.
[include]
	path = ~/.config/git/config.local
