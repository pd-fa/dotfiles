/* Generated from theme/palette.toml by theme/sync-theme.py — do not edit.
 *
 * Sidebery keeps its styles in extension storage, not on disk, so this file
 * cannot be symlinked anywhere — paste it into Sidebery settings > Styles
 * editor > Sidebar, or import firefox/sidebery-settings.json, which carries a
 * copy in its sidebarCSS/groupCSS keys.
 *
 * Sidebery exposes two theming layers and both are supported API:
 *
 *   --s-*   Scheme layer. Twelve names, each read as var(--s-NAME, fallback)
 *           by the internal colours. Sets the palette identity in one place.
 *   plain   Working layer. Every name listed in Styles editor, covering
 *           geometry, typography and per-component colour. The scheme layer
 *           cannot reach these — they default to Sidebery's own values, which
 *           is why a scheme-only theme still renders at system-ui 15px.
 *
 * Sidebery appends this as <style id="custom_css"> after its bundled sheet, so
 * a specificity tie against its own #root rules resolves in favour of this file.
 */

#root.root {
  /* Scheme layer — palette identity */
  --s-frame-bg: {{bg_dark}};
  --s-frame-fg: {{fg}};
  --s-toolbar-bg: {{bar}};
  --s-toolbar-fg: {{fg_dim}};
  --s-toolbar-border: {{bg_selection}};
  --s-accent: {{accent}};
  --s-act-el-bg: {{bg_selection}};
  --s-act-el-fg: {{fg}};
  --s-act-el-border: {{accent}};
  --s-popup-bg: {{panel}};
  --s-popup-fg: {{fg}};
  --s-popup-border: {{bg_selection}};

  /* Typography. NFP is the proportional cut of the terminal face — same
   * identity, but fits roughly a quarter more title before truncating in a
   * narrow sidebar. Swap to "ZedMono NFM" for the monospaced cut. */
  --general-font-family: "ZedMono NFP", ui-sans-serif, system-ui;
  --tabs-font: 500 .8125rem var(--general-font-family);
  --tabs-count-font: 600 .5625rem var(--general-font-family);
  --tabs-badge-value-font: 600 .5rem var(--general-font-family);
  --bookmarks-bookmark-font: .8125rem var(--general-font-family);
  --bookmarks-folder-font: 500 .8125rem var(--general-font-family);
  --ctx-menu-font: .8125rem var(--general-font-family);
  --search-font-size: .8125rem;

  /* Density. --general-margin feeds --tabs-margin, which Sidebery consumes
   * inside calc() — it must stay a single length, never a box shorthand. */
  --general-margin: 3px;
  --general-border-radius: 6px;
  --tabs-height: 28px;
  --tabs-pinned-width: 38px;
  --tabs-pinned-height: 38px;
  --tabs-inner-gap: 9px;
  --tabs-indent: 12px;
  --tabs-border-radius: 6px;
  --nav-btn-height: 32px;
  --nav-btn-width: 32px;
  --bottom-bar-height: 26px;
  --ctx-menu-icon-opt-height: 28px;
  --ctx-menu-text-opt-height: 24px;

  /* Component colour beyond the scheme layer's reach */
  --tabs-normal-fg: {{fg_dim}};
  --tabs-activated-fg: {{fg}};
  --tabs-activated-bg: {{bg_selection}};
  --tabs-progress-bg: {{bg_highlight}};
  --tabs-lvl-opacity: .3;
  --tabs-discarded-title-opacity: .45;
  --tabs-discarded-favicon-opacity: .4;
  --tabs-notification-badge-count-fg: {{ink}};
  --tabs-notification-badge-count-bg: {{accent}};
  --tabs-notification-badge-dot-bg: {{accent}};
  --nav-btn-fg: {{fg_dim}};
  --nav-btn-accent: {{accent}};
  --badge-fg: {{ink}};
  --badge-bg: {{accent}};
  --badge-urgent-fg: {{ink}};
  --badge-urgent-bg: {{err_bright}};
  --border: {{bg_selection}};
  --scroll-color: {{muted}};
  --scroll-progress-bg: {{accent}};
  --status-ok: {{ok}};
  --status-err: {{err_bright}};
  --status-active: {{accent}};
  --status-notice: {{info}};
  --notification-fg: {{fg}};
  --notification-bg: {{panel}};
  --ctx-menu-fg: {{fg}};
  --ctx-menu-bg: {{panel}};
  --ctx-menu-separator: {{bg_selection}};
  --bookmarks-expanded-folder-bg: {{bg_highlight}};
  --bookmarks-node-activated-fg: {{fg}};
}
