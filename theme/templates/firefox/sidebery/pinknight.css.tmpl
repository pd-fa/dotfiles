/* Generated from theme/palette.toml by theme/sync-theme.py — do not edit.
 *
 * Sidebery keeps its styles in extension storage, not on disk, so this file
 * cannot be symlinked anywhere — paste it into Sidebery settings > Styles
 * editor > Sidebar, then export the settings to firefox/sidebery-settings.json
 * so the paste survives a rebuild. It is generated rather than hand-written so
 * a palette retune reaches the sidebar instead of stopping at the chrome.
 *
 * Sidebery defines every internal colour as var(--s-NAME, fallback), so these
 * twelve --s-* names are its whole supported theming surface. Anything else in
 * the sidebar is a private class that renames without warning.
 */

#root.root {
  --s-frame-bg: {{bg_dark}};
  --s-frame-fg: {{fg}};
  --s-toolbar-bg: {{bar}};
  --s-toolbar-fg: {{fg_dim}};
  --s-toolbar-border: {{bg_selection}};
  --s-accent: {{accent}};
  --s-act-el-bg: {{bg_selection}};
  --s-act-el-fg: {{fg}};
  --s-act-el-border: {{accent}};
  --s-popup-bg: {{panel}};
  --s-popup-fg: {{fg}};
  --s-popup-border: {{bg_selection}};
}
