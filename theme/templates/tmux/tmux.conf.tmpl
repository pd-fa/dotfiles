# Generated from theme/palette.toml by theme/sync-theme.py — do not edit.
# vim:ft=tmux
# tmux display things in 256 colors
# set -g default-terminal "tmux-256color"

# Improve colors
set -g default-terminal "tmux-256color"

# enable italics
set -as terminal-overrides ',xterm*:Tc:sitm=\E[3m'

# Enable undercurl
set -as terminal-overrides ',*:Smulx=\E[4::%p1%dm'

# Enable undercurl colors
set -as terminal-overrides ',*:Setulc=\E[58::2::%p1%{65536}%/%d::%p1%{256}%/%{255}%&%d::%p1%{255}%&%d%;m'

set -g history-limit 50000

# automatically renumber tmux windows
set -g renumber-windows on

######################
#### General Settings ####
######################

 # set the prefix to control-a. This is more convenient than control-b
 # and 'a' is right next to Caps Lock (which I remap to control)
set -g prefix C-b
bind C-b send-prefix
bind-key b send-prefix

set -g set-clipboard on

# enable mouse support for switching panes/windows
setw -g mouse on

# make delay shorter
set -g escape-time 0
# make window/pane index start with 1
set -g base-index 1
setw -g pane-base-index 1
set-option -g focus-events on
set-option -g set-titles on

# set vi mode for copy mode
setw -g mode-keys vi
set -g status-keys vi

# automatically rename windows when an explicit name is not set
set-window-option -g automatic-rename on
set-option -g automatic-rename-format "#{b:pane_current_path}"

# set the default title format
set-option -g set-titles-string "#T - #W"

# disabled activity monitoring
setw -g monitor-activity off
set -g visual-activity off

# Rather than constraining window size to the maximum size of any client
# connected to the *session*, constrain window size to the maximum size of any
# client connected to *that window*. Much more reasonable.
setw -g aggressive-resize on

######################
#### Key Bindings ####
######################

# keep CWD when opening new window
unbind c
bind c new-window -c "#{pane_current_path}"

# tile all windows
unbind =
bind = select-layout tiled

# reload config file
bind r source-file ~/.config/tmux/tmux.conf \; display "Config Reloaded!"

# split window and fix path for tmux 1.9
bind | split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"

# synchronize all panes in a window
bind y setw synchronize-panes

# pane movement shortcuts
bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R

bind -r C-h select-window -t :-
bind -r C-l select-window -t :+

# Resize pane shortcuts
bind -r H resize-pane -L 10
bind -r J resize-pane -D 10
bind -r K resize-pane -U 10
bind -r L resize-pane -R 10

# open lazygit in a popup
bind-key g display-popup -w "80%" -h "80%" -d "#{pane_current_path}" -E "lazygit"

# open yazi file manager in a popup
bind-key e display-popup -w "80%" -h "80%" -d "#{pane_current_path}" -E "yazi"

# toggle the status bar
bind-key -T prefix T set-option -g status

unbind s
bind s display-popup -E "\
  tmux list-sessions -F '#{?session_attached,,#{session_name}} ' |\
  sed '/^\s*$/d' |\
  fzf --reverse --header jump-to-session |\
  xargs tmux switch-client -t"

# tmux sessionizer - find and switch to project
bind-key -r F run-shell "tmux neww ~/.config/tmux/scripts/tmux-sessionizer"

# more settings to make copy-mode more vim-like
unbind [
bind Escape copy-mode
unbind p
bind p paste-buffer
bind -T copy-mode-vi v send -X begin-selection

if-shell "[ -z \"$TMUX_MINIMAL\" ]" {
  set -g status on
} {
  set -g status off
  set-hook -g after-new-window      'if "[ #{session_windows} -gt 1 ]" "set status on"'
  set-hook -g after-kill-pane       'if "[ #{session_windows} -lt 2 ]" "set status off"'
  set-hook -g pane-exited           'if "[ #{session_windows} -lt 2 ]" "set status off"'
  set-hook -g window-layout-changed 'if "[ #{session_windows} -lt 2 ]" "set status off"'
}

# Personal pink theme (Tokyo Night derived)
# Ramp:  bar {{bar}} | panel {{panel}} | accent {{accent}}
#        fg  {{fg}} | dim   {{fg_dim}} | ink    {{ink}}

set -g mode-style "fg={{ink}},bg={{accent}}"

set -g message-style "fg={{fg}},bg={{panel}}"
set -g message-command-style "fg={{fg}},bg={{panel}}"

set -g pane-border-style "fg={{panel}}"
set -g pane-active-border-style "fg={{accent}}"

set -g status "on"
set -g status-position top
set -g status-justify "left"

set -g status-style "fg={{fg}},bg={{bar}}"

set -g status-left-length "100"
set -g status-right-length "100"

set -g status-left-style NONE
set -g status-right-style NONE

set -g status-left "#[fg={{ink}},bg={{accent}},bold] #S #[default] "
set -g status-right "#[fg={{fg}},bg={{bar}}] #{prefix_highlight} #[fg={{fg}},bg={{panel}}] %Y-%m-%d  %I:%M %p #[fg={{ink}},bg={{accent}},bold] #h "
if-shell '[ "$(tmux show-option -gqv "clock-mode-style")" == "24" ]' {
  set -g status-right "#[fg={{fg}},bg={{bar}}] #{prefix_highlight} #[fg={{fg}},bg={{panel}}] %Y-%m-%d  %H:%M #[fg={{ink}},bg={{accent}},bold] #h "
}

setw -g window-status-activity-style "underscore,fg={{fg}},bg={{bar}}"
setw -g window-status-separator ""
setw -g window-status-style "NONE,fg={{fg_dim}},bg={{bar}}"
setw -g window-status-format " #I  #W #F "
setw -g window-status-current-format "#[fg={{ink}},bg={{accent}},bold] #I  #W #F "

# tmux-plugins/tmux-prefix-highlight support
set -g @prefix_highlight_output_prefix "#[fg={{ink}}]#[bg={{warn}}]"
set -g @prefix_highlight_output_suffix ""

######################
#### Plugin Manager ####
######################

# tpm lives outside its default ~/.tmux/plugins, so it must be told where
set-environment -g TMUX_PLUGIN_MANAGER_PATH '~/.config/tmux/plugins/'

# List of plugins
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'
set -g @plugin 'christoomey/vim-tmux-navigator'
set -g @plugin 'tmux-plugins/tmux-yank'

# Plugin settings
set -g @continuum-restore 'on'
set -g @resurrect-strategy-nvim 'session'
set -g @resurrect-capture-pane-contents 'on'

# Yank settings
set -g @yank_selection_mouse 'clipboard'

# Bootstrap tpm on a fresh machine, then install plugins
if "test ! -d ~/.config/tmux/plugins/tpm" \
   "run 'git clone -q https://github.com/tmux-plugins/tpm ~/.config/tmux/plugins/tpm && ~/.config/tmux/plugins/tpm/bin/install_plugins'"

# Initialize TPM (keep this line at the very bottom)
run '~/.config/tmux/plugins/tpm/tpm'
