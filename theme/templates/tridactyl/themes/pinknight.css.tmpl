/* Generated from theme/palette.toml by theme/sync-theme.py — do not edit.
 *
 * Loaded by `colourscheme pinknight` in tridactyl/tridactylrc. Tridactyl reads
 * custom themes from <dir of tridactylrc>/themes/<name>.css, which is this
 * path, so no symlink is involved — but it reads them through the native
 * messenger, so `:installnative` must have run first or the command errors
 * with "Couldn't read theme".
 *
 * Variables only. Tridactyl's base stylesheet supplies the layout and reads
 * every colour through these names, so overriding structure here would fork
 * upstream CSS for no gain.
 */

:root {
  --tridactyl-font-family: "ZedMono Nerd Font", monospace;
  --tridactyl-bg: {{bg_dark}};
  --tridactyl-fg: {{fg}};

  --tridactyl-cmdl-bg: {{bg_dark}};
  --tridactyl-cmdl-fg: {{fg}};
  --tridactyl-cmdl-font-size: 14px;

  --tridactyl-cmplt-bg: {{bg}};
  --tridactyl-cmplt-fg: {{fg}};
  --tridactyl-cmplt-option-bg: {{bg}};
  --tridactyl-cmplt-option-fg: {{fg_dim}};
  --tridactyl-cmplt-option-focus-bg: {{bg_selection}};
  --tridactyl-cmplt-option-focus-fg: {{fg}};
  --tridactyl-cmplt-sectionheader-bg: {{panel}};
  --tridactyl-cmplt-sectionheader-fg: {{accent}};

  /* Mode indicator, bottom-right. err carries meaning here — it is what
   * distinguishes ignore mode from normal mode at a glance. */
  --tridactyl-status-bg: {{panel}};
  --tridactyl-status-fg: {{fg}};
  --tridactyl-status-border: 1px solid {{accent}};

  /* Hint tags. accent_bright on ink is the highest-contrast pair in the
   * palette, which is the whole job of a hint. */
  --tridactyl-hintspan-bg: {{accent_bright}};
  --tridactyl-hintspan-fg: {{ink}};
  --tridactyl-hintspan-font-size: 11px;
  --tridactyl-hintspan-border-color: {{accent_deep}};
  --tridactyl-hintspan-border-width: 1px;

  --tridactyl-hintspan-active-bg: {{warn}};
  --tridactyl-hintspan-active-fg: {{ink}};

  --tridactyl-hint-bg: {{bg_selection}};
  --tridactyl-hint-outline: 1px solid {{accent}};
  --tridactyl-hint-active-bg: {{accent_deep}};
  --tridactyl-hint-active-outline: 1px solid {{accent_bright}};

  --tridactyl-search-highlight-color: {{warn}};
}
