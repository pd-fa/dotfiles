" Tridactyl config. Read from $XDG_CONFIG_HOME/tridactyl/tridactylrc, which is
" this repo — so unlike the shell config it needs no bootstrap symlink.
"
" Requires the native messenger: run `:installnative` once per machine. Without
" it Tridactyl never reads this file and silently keeps its defaults, and
" `colourscheme pinknight` fails with "Couldn't read theme".

" Tridactyl keeps settings in extension storage, which survives a profile
" rebuild and would otherwise shadow anything deleted from this file. Clearing
" first makes the rc authoritative, the same way user.js is for about:config.
sanitise tridactyllocal tridactylsync

" Rendered from theme/palette.toml into tridactyl/themes/pinknight.css.
colourscheme pinknight

set modeindicator true
set smoothscroll true
set searchengine duckduckgo

" Tridactyl's own new tab page would paint before the palette background does.
set newtab about:blank

" The reason Tridactyl earns its place over Vimium: gf on any text field opens
" the real editor rather than a textarea emulating one. Absolute path because
" the native messenger runs without a login shell, so brew's bin is not on PATH.
set editorcmd /Applications/Ghostty.app/Contents/MacOS/ghostty -e nvim %f

" Sites that own their entire keymap. Tridactyl grabbing keys on these breaks
" the app rather than improving it, so it stands down completely.
blacklistadd mail.google.com
blacklistadd docs.google.com
blacklistadd calendar.google.com

bind gh home
bind <C-[> composite mode normal ; hidecmdline
